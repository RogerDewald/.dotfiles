#!/usr/bin/env bash
# Start polybar with this machine's battery and adapter filled in.
#
# These are the only two things in the polybar config that genuinely differ
# per machine (BAT0/ADP0 on one laptop, BAT1/ACAD on another), and they used
# to be the reason for a separate git branch per machine. Detect them from
# sysfs instead. Network interfaces need no detection — polybar picks those
# itself from `interface-type`.

bar="${1:-toph}"

# First matching supply in sorted glob order. Laptops have exactly one
# Mains (ADP0 here, ACAD on the Asus); if a machine ever had two, this
# picks the alphabetically first, which is at least deterministic.
pick_supply() {
    local type="$1" supply
    for supply in /sys/class/power_supply/*; do
        [[ -r "$supply/type" ]] || continue
        if [[ "$(<"$supply/type")" == "$type" ]]; then
            basename "$supply"
            return 0
        fi
    done
    return 1
}

# Export only on a hit. An exported-but-empty var is NOT the same as unset:
# polybar would use the empty string instead of the ${env:...:BAT0} fallback.
if battery="$(pick_supply Battery)"; then
    export POLYBAR_BATTERY="$battery"
fi
if adapter="$(pick_supply Mains)"; then
    export POLYBAR_ADAPTER="$adapter"
fi

killall -q polybar
while pgrep -x polybar >/dev/null; do sleep 0.1; done

# The log dir is not guaranteed to exist on a fresh install, and the
# redirect below is what starts polybar — if it fails, no bar.
log_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
mkdir -p "$log_dir" || log_dir=/tmp

polybar "$bar" >>"$log_dir/polybar-${bar}.log" 2>&1 &
